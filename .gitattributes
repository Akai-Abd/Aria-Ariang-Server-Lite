# Set default behavior for all text files to enforce LF line endings
* text=auto eol=lf

# Explicitly ensure shell scripts and configuration files use LF
*.sh text eol=lf
*.conf text eol=lf
*.env* text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
